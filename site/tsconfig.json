{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@kit/*": ["../src/*"], "lucide-react": ["./node_modules/lucide-react/dist/lucide-react.d.ts"], "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"], "react-dom": ["./node_modules/@types/react-dom"], "react-dom/*": ["./node_modules/@types/react-dom/*"] }
  },
  "include": ["src", "../src"]
}
